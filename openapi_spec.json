{
  "openapi": "3.1.0",
  "info": {
    "title": "Molecular Docking Vina Scorer API",
    "description": "Educational Vina-like pose scoring with a separate generic operational audit service. Live documentation is available at /openapi.json and /docs.",
    "version": "3.0.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "JSON counters (not Prometheus text)"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Air-gapped supervisory conversational assistant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/score": {
      "post": {
        "summary": "Calculate simplified Vina-like pose score",
        "description": "Calculates a heuristic potential for already positioned atoms; does not run docking or validate binding affinity.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ligand",
                  "receptor"
                ],
                "properties": {
                  "ligand": {
                    "type": "object",
                    "required": [
                      "atoms"
                    ],
                    "properties": {
                      "atoms": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 128,
                        "items": {
                          "type": "object",
                          "required": [
                            "element",
                            "x",
                            "y",
                            "z"
                          ],
                          "properties": {
                            "element": {
                              "type": "string"
                            },
                            "x": {
                              "type": "number"
                            },
                            "y": {
                              "type": "number"
                            },
                            "z": {
                              "type": "number"
                            },
                            "donor": {
                              "type": "boolean"
                            },
                            "acceptor": {
                              "type": "boolean"
                            },
                            "hydrophobic": {
                              "type": "boolean"
                            }
                          }
                        }
                      },
                      "properties": {
                        "type": "object",
                        "properties": {
                          "rotatable_bonds": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "mw": {
                            "type": "number",
                            "minimum": 0
                          },
                          "logp": {
                            "type": "number"
                          },
                          "hbd": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "hba": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "psa": {
                            "type": "number",
                            "minimum": 0
                          }
                        }
                      }
                    }
                  },
                  "receptor": {
                    "type": "object",
                    "required": [
                      "atoms"
                    ],
                    "properties": {
                      "atoms": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 128,
                        "items": {
                          "type": "object",
                          "required": [
                            "element",
                            "x",
                            "y",
                            "z"
                          ],
                          "properties": {
                            "element": {
                              "type": "string"
                            },
                            "x": {
                              "type": "number"
                            },
                            "y": {
                              "type": "number"
                            },
                            "z": {
                              "type": "number"
                            },
                            "donor": {
                              "type": "boolean"
                            },
                            "acceptor": {
                              "type": "boolean"
                            },
                            "hydrophobic": {
                              "type": "boolean"
                            }
                          }
                        }
                      },
                      "properties": {
                        "type": "object",
                        "properties": {
                          "rotatable_bonds": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "mw": {
                            "type": "number",
                            "minimum": 0
                          },
                          "logp": {
                            "type": "number"
                          },
                          "hbd": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "hba": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "psa": {
                            "type": "number",
                            "minimum": 0
                          }
                        }
                      }
                    }
                  },
                  "temperature": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "rotatable_bonds": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Score components and optional descriptor heuristics"
          },
          "422": {
            "description": "Invalid molecular input"
          }
        }
      }
    }
  }
}
